# Production / Local Server Port
PORT=3000

# Base Application URL (e.g., http://localhost:3000 for local VS Code testing)
APP_URL="http://localhost:3000"

# Gemini API Key (Optional: for AI post-interview reports & transcription)
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=""

# MongoDB Connection String (Optional: for persistent MongoDB database backend)
# MONGODB_URI="mongodb://localhost:27017/ai-interview-proctor"

# JWT Secret Key for user session authentication
JWT_SECRET="super-secret-jwt-token-key-change-in-production"
